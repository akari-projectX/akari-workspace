new file mode 100644
index 0000000..d8f9cdb
--- /dev/null
+++ b/adapter/managed_user.go
@@ -0,0 +1,62 @@
+package adapter
+
+import (
+	"context"
+	"sync"
+
+	"github.com/sagernet/sing/common/auth"
+)
+
+// ManagedUser is the immutable identity of one user in one published user
+// table of an inbound. Handshakes carry the *pointer* in the auth context
+// (auth.ContextWithUser) all the way to the router and its trackers, so a
+// concurrent table replacement can never re-attribute an in-flight
+// connection (no positional indices), and a rotated credential (same name,
+// new record) is distinguishable from the old one by pointer identity.
+type ManagedUser struct {
+	Name string
+}
+
+func ManagedUserFromContext(ctx context.Context) (*ManagedUser, bool) {
+	return auth.UserFromContext[*ManagedUser](ctx)
+}
+
+// UserReplaceableInbound: ReplaceUsers atomically publishes a new user
+// table built from users (the inbound's own option user type). Existing
+// connections and sessions are untouched; handshakes that started against
+// the previous table finish against it. Revoking access of removed users'
+// live connections is the caller's job (route-time tracker), because the
+// inbound does not track connections.
+type UserReplaceableInbound interface {
+	Inbound
+	ReplaceUsers(users any) ([]*ManagedUser, error)
+}
+
+// ManagedUserTable hands out identities for successive user tables of one
+// inbound: a user whose (name, credential) is unchanged keeps its pointer
+// (its live connections stay valid); anything else gets a fresh pointer.
+type ManagedUserTable struct {
+	access sync.Mutex
+	byCred map[string]*ManagedUser
+}
+
+// Next returns one identity per entry (creds[i] = canonical credential of
+// user i) and makes this the current generation. Callers publish the
+// protocol table built from the result atomically afterwards.
+func (t *ManagedUserTable) Next(names []string, creds []string) []*ManagedUser {
+	t.access.Lock()
+	defer t.access.Unlock()
+	next := make(map[string]*ManagedUser, len(names))
+	result := make([]*ManagedUser, len(names))
+	for i, name := range names {
+		key := name + "\x00" + creds[i]
+		user := t.byCred[key]
+		if user == nil {
+			user = &ManagedUser{Name: name}
+		}
+		next[key] = user
+		result[i] = user
+	}
+	t.byCred = next
+	return result
+}
