+// ReplaceUsers publishes a new immutable user table (atomic in sing-quic).
+// Live QUIC sessions are untouched; their identity is the *ManagedUser they
+// authenticated with.
+func (h *Inbound) ReplaceUsers(anyUsers any) ([]*adapter.ManagedUser, error) {
+	users, ok := anyUsers.([]option.Hysteria2User)
+	if !ok {
+		return nil, E.New("hysteria2: ReplaceUsers: want []option.Hysteria2User")
+	}
+	managed := make([]*adapter.ManagedUser, len(users))
+	passwords := make([]string, len(users))
+	for i, u := range users {
+		passwords[i] = u.Password
+	}
+	managed = h.managedUsers.Next(common.Map(users, func(it option.Hysteria2User) string { return it.Name }), passwords)
+	h.service.UpdateUsers(managed, passwords)
+	return managed, nil
+}
